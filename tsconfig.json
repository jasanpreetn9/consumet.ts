{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Node16",
    "rootDir": "src",
    "moduleResolution": "Node16",
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "lib": ["esnext"],
  "include": ["src"]
}
